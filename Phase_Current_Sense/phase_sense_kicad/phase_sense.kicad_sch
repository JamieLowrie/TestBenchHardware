	(text "PHASE C VOLTAGE: VC = V(PC_OUT) x 2.7k / 96.7k  (100 V -> 2.79 V, FS 118 V), fc ~2.8 kHz"
		(exclude_from_sim no)
		(at 234.95 90.17 0)
