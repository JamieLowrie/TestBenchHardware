	)
	(text "2. VIOUT -> 1k / 10n RC (fc ~16 kHz) -> I[A/B/C] -> MCU ADC. The 1k isolates the 10n (VIOUT max load 6 nF)."
		(exclude_from_sim no)
		(at 187.96 134.79 0)
		(effects
